# 외부에서는 Cloudflare Tunnel로만 들어오므로 로컬에만 바인딩
HOST=127.0.0.1
PORT=4000

# 구절 교체 주기 (ms)
PERIOD_MS=60000

# 비우면 레포 루트의 content/verses.json
CONTENT_PATH=

# 프론트 도메인 (쉼표 구분). 비우면 전부 허용 (개발용)
ALLOWED_ORIGINS=https://commonleaf.yeoul.dev,http://localhost:3000

MAX_CONN_PER_IP=20
PRESENCE_THROTTLE_MS=1000
BOW_THROTTLE_MS=500
BOW_COOLDOWN_MS=800
