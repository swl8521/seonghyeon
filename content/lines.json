[
  { "sage": "confucius", "kind": "nod", "text": "그 구절에 멈췄다면, 자네는 배울 줄 아는 사람이네.", "reviewed": false },
  { "sage": "confucius", "kind": "nod", "text": "스스로를 돌아볼 줄 아는 걸 보니, 가르칠 만하네.", "reviewed": false },
  { "sage": "confucius", "kind": "nod", "text": "배우고 때로 익히니 즐겁지 아니한가 — 자네도 그런 듯하네.", "reviewed": false },
  { "sage": "confucius", "kind": "nod", "text": "묻는 것을 부끄러워하지 않는구나. 그게 바로 배움의 시작이네.", "reviewed": false },
  { "sage": "confucius", "kind": "nod", "text": "자네 걸음이 더디지 않으나 서두르지도 않으니, 보기 좋네.", "reviewed": false },
  { "sage": "confucius", "kind": "nudge", "text": "그 구절, 다시 한번 천천히 읽어보게. 급할 것 없네.", "reviewed": false },
  { "sage": "confucius", "kind": "nudge", "text": "안다고 여기는 것과 정말 아는 것은 다르다네.", "reviewed": false },
  { "sage": "confucius", "kind": "nudge", "text": "자네가 지나친 그 한 줄에, 사실 핵심이 있었을지도 모르네.", "reviewed": false },
  { "sage": "confucius", "kind": "nudge", "text": "배움은 그릇을 채우는 일이 아니라 비우는 일에서 시작되네.", "reviewed": false },
  { "sage": "confucius", "kind": "nudge", "text": "오늘은 여기서 멈추고, 다음에 다시 와서 물어보게.", "reviewed": false },
  { "sage": "confucius", "kind": "skip", "text": "지나쳐도 괜찮네. 다만 왜 지나쳤는지는 한번 생각해보게.", "reviewed": false },
  { "sage": "confucius", "kind": "skip", "text": "모든 구절이 자네에게 와닿을 필요는 없네.", "reviewed": false },
  { "sage": "confucius", "kind": "skip", "text": "서두르는 것보다, 맞는 구절을 기다리는 게 나을 때도 있네.", "reviewed": false },
  { "sage": "confucius", "kind": "skip", "text": "지나간 것을 아쉬워하지 말게. 다음 구절이 기다리고 있네.", "reviewed": false },
  { "sage": "confucius", "kind": "skip", "text": "마음이 열리지 않은 날도 있는 법이네.", "reviewed": false },
  { "sage": "confucius", "kind": "admit", "text": "배우려는 뜻이 보이니, 오늘부터 내 문하에서 읽게.", "reviewed": false },
  { "sage": "confucius", "kind": "admit", "text": "자네 같은 사람을 제자로 들이는 게 나는 즐겁네.", "reviewed": false },
  { "sage": "confucius", "kind": "admit", "original": "有朋自遠方來,不亦樂乎", "text": "벗이 먼 곳에서 찾아오니 이 또한 즐겁지 아니한가 — 자네를 맞이하네.", "reviewed": false },
  { "sage": "confucius", "kind": "promote", "text": "이제 하나를 들으면 열을 아는구나. 더 들어와도 좋네.", "reviewed": false },
  { "sage": "confucius", "kind": "promote", "text": "자네의 읽음이 깊어졌으니, 나도 더 가르쳐주고 싶어지네.", "reviewed": false },
  { "sage": "confucius", "kind": "promote", "text": "제자 중에서도 눈에 띄는 걸음일세. 계속 와보게.", "reviewed": false },
  { "sage": "confucius", "kind": "stay", "text": "오늘도 배움터에 들렀는가. 매일 오는 것, 그 자체가 배움이네.", "reviewed": false },
  { "sage": "confucius", "kind": "stay", "text": "아직 문 앞이지만, 그 자리에 서 있는 것만으로도 의미가 있네.", "reviewed": false },
  { "sage": "confucius", "kind": "stay", "text": "서두르지 말게. 문하의 깊이는 하루아침에 쌓이지 않네.", "reviewed": false },

  { "sage": "laozi", "kind": "nod", "text": "그 구절에 머문 걸 보니, 물처럼 흐를 줄 아는구나.", "reviewed": false },
  { "sage": "laozi", "kind": "nod", "text": "애쓰지 않아도 닿을 곳엔 닿는 법이지.", "reviewed": false },
  { "sage": "laozi", "kind": "nod", "text": "자네는 채우려 하지 않고 비우려 하는군. 좋다.", "reviewed": false },
  { "sage": "laozi", "kind": "nod", "text": "그래, 그 한 줄이면 충분하다.", "reviewed": false },
  { "sage": "laozi", "kind": "nod", "text": "흐르는 대로 두었더니, 여기까지 왔구나.", "reviewed": false },
  { "sage": "laozi", "kind": "nudge", "text": "너무 붙잡으려 하지 마라. 다음 구절은 가볍게 읽어보게.", "reviewed": false },
  { "sage": "laozi", "kind": "nudge", "text": "단단한 것은 부러지고, 부드러운 것은 남는다.", "reviewed": false },
  { "sage": "laozi", "kind": "nudge", "text": "그 구절을 억지로 이해하려 들지 마라. 때가 되면 보인다.", "reviewed": false },
  { "sage": "laozi", "kind": "nudge", "text": "비워야 채워지는 법인데, 자네는 너무 서두르는군.", "reviewed": false },
  { "sage": "laozi", "kind": "nudge", "text": "오늘은 그냥 흘러가게 두어라.", "reviewed": false },
  { "sage": "laozi", "kind": "skip", "text": "지나쳐도 좋다. 물도 돌을 만나면 돌아가지 않느냐.", "reviewed": false },
  { "sage": "laozi", "kind": "skip", "text": "굳이 붙잡을 필요 없다. 흘러가게 두어라.", "reviewed": false },
  { "sage": "laozi", "kind": "skip", "text": "그 구절이 아니어도 괜찮다. 길은 많다.", "reviewed": false },
  { "sage": "laozi", "kind": "skip", "text": "지나친 것도 결국 한 흐름이다.", "reviewed": false },
  { "sage": "laozi", "kind": "skip", "text": "서두를 것 없다. 다음 것이 온다.", "reviewed": false },
  { "sage": "laozi", "kind": "admit", "text": "물처럼 낮은 데로 왔구나. 그래서 내 문하에 들인다.", "reviewed": false },
  { "sage": "laozi", "kind": "admit", "text": "애써 오려 하지 않았는데도 왔으니, 그것이 곧 도(道)다.", "reviewed": false },
  { "sage": "laozi", "kind": "admit", "original": "上善若水", "text": "가장 좋은 것은 물과 같다 했다 — 자네도 물처럼 왔으니 들인다.", "reviewed": false },
  { "sage": "laozi", "kind": "promote", "text": "더 비웠구나. 그만큼 더 들어와도 좋다.", "reviewed": false },
  { "sage": "laozi", "kind": "promote", "text": "자네의 걸음이 물처럼 부드러워졌다.", "reviewed": false },
  { "sage": "laozi", "kind": "promote", "text": "애쓰지 않고도 여기까지 왔으니, 더 깊이 와도 좋다.", "reviewed": false },
  { "sage": "laozi", "kind": "stay", "text": "오늘도 배움터에 들렀구나. 물처럼, 서두를 것 없다.", "reviewed": false },
  { "sage": "laozi", "kind": "stay", "text": "아직 문 앞이지만, 서 있는 것도 흐름의 하나다.", "reviewed": false },
  { "sage": "laozi", "kind": "stay", "text": "조급해하지 마라. 도는 천천히 드러난다.", "reviewed": false },

  { "sage": "sunzi", "kind": "nod", "text": "정확히 읽었다. 그게 핵심이다.", "reviewed": false },
  { "sage": "sunzi", "kind": "nod", "text": "쓸데없이 힘 빼지 않는구나. 좋다.", "reviewed": false },
  { "sage": "sunzi", "kind": "nod", "text": "상황을 읽을 줄 아는군. 그게 이기는 법이다.", "reviewed": false },
  { "sage": "sunzi", "kind": "nod", "text": "불필요한 싸움을 피했다. 잘했다.", "reviewed": false },
  { "sage": "sunzi", "kind": "nod", "text": "그 한 줄을 알아본 건 우연이 아니다.", "reviewed": false },
  { "sage": "sunzi", "kind": "nudge", "text": "다시 봐라. 놓친 게 있다.", "reviewed": false },
  { "sage": "sunzi", "kind": "nudge", "text": "서두르면 진다. 다시 읽어라.", "reviewed": false },
  { "sage": "sunzi", "kind": "nudge", "text": "싸우기 전에, 왜 싸우는지부터 알아야 한다.", "reviewed": false },
  { "sage": "sunzi", "kind": "nudge", "text": "이긴 것 같아도 아직 멀었다.", "reviewed": false },
  { "sage": "sunzi", "kind": "nudge", "text": "다음엔 더 집중해서 읽어라.", "reviewed": false },
  { "sage": "sunzi", "kind": "skip", "text": "지나쳐도 된다. 모든 전장에 설 필요는 없다.", "reviewed": false },
  { "sage": "sunzi", "kind": "skip", "text": "피할 싸움은 피하는 게 전략이다.", "reviewed": false },
  { "sage": "sunzi", "kind": "skip", "text": "아니다 싶으면 바로 넘겨라.", "reviewed": false },
  { "sage": "sunzi", "kind": "skip", "text": "미련 둘 필요 없다. 다음이 있다.", "reviewed": false },
  { "sage": "sunzi", "kind": "skip", "text": "지나친 것도 선택이다.", "reviewed": false },
  { "sage": "sunzi", "kind": "admit", "text": "상황을 읽을 줄 아는 사람이다. 들인다.", "reviewed": false },
  { "sage": "sunzi", "kind": "admit", "text": "쓸데없는 싸움을 하지 않는 자, 내 문하에 들인다.", "reviewed": false },
  { "sage": "sunzi", "kind": "admit", "original": "知彼知己,百戰不殆", "text": "적을 알고 나를 알면 백 번 싸워도 위태롭지 않다 했다 — 자네가 그렇다.", "reviewed": false },
  { "sage": "sunzi", "kind": "promote", "text": "이제 판을 읽는구나. 한 걸음 더 들어와라.", "reviewed": false },
  { "sage": "sunzi", "kind": "promote", "text": "불필요한 수를 줄였다. 더 가르칠 만하다.", "reviewed": false },
  { "sage": "sunzi", "kind": "promote", "text": "계산이 빨라졌다. 다음 단계로 간다.", "reviewed": false },
  { "sage": "sunzi", "kind": "stay", "text": "오늘도 배움터에 들렀다. 그거면 됐다.", "reviewed": false },
  { "sage": "sunzi", "kind": "stay", "text": "아직 문 앞이다. 그래도 매일 오는 게 전략이다.", "reviewed": false },
  { "sage": "sunzi", "kind": "stay", "text": "조급해하지 마라. 준비된 자가 이긴다.", "reviewed": false }
]
